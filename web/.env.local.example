R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Two buckets on purpose: R2 grants public read per bucket, not per prefix.
# Previews bucket: public read, bound to a public r2.dev / custom domain.
R2_BUCKET_PREVIEWS=orca-eventos-previews
# Originals bucket: NO public access. Served only through presigned URLs.
R2_BUCKET_ORIGINALS=orca-eventos-originais
# Public domain bound to the PREVIEWS bucket only (no trailing slash).
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# face-service must be bound to a private/internal interface only.
FACE_SERVICE_URL=http://localhost:8000
# Shared secret sent as `X-Face-Service-Token`. Must match FACE_SERVICE_TOKEN
# in the face-service process environment. Generate with: openssl rand -hex 32
FACE_SERVICE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PHOTO_PRICE_CENTS=1500
# Public copy of PHOTO_PRICE_CENTS, shown to the buyer before checkout. Keep
# these two values in sync manually — the server never trusts this one.
NEXT_PUBLIC_PHOTO_PRICE_CENTS=1500
# Shared secret guarding every /api/admin route. Send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
